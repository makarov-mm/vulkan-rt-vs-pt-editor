#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

// Right half: Monte Carlo path tracing.
//  - diffuse surfaces bounce with cosine-weighted importance sampling, which
//    gives full global illumination (colour bleeding, indirect light);
//  - direct light uses next event estimation toward the spherical area light,
//    combined with BSDF sampling by multiple importance sampling (power heuristic);
//  - the mirror lobe is chosen stochastically with probability `reflectivity`;
//  - glass: stochastic dispersive Fresnel (shared with the Whitted view);
//  - Russian roulette terminates long paths without bias.
// Also writes the denoiser's guide (normal + depth) and albedo images.

#include "raygen_common.glsl"

layout(binding = 8, set = 0, rgba32f) uniform image2D guideImage;    // xyz = primary normal, w = depth (0 = sky, < 0 = glass)
layout(binding = 9, set = 0, rgba8)   uniform image2D albedoImage;   // primary-hit albedo for demodulation

// Per-sample radiance clamp: removes fireflies from rare low-probability
// paths at the cost of a little energy. Raise it for a more exact result.
const float FIREFLY_CLAMP = 24.0;

// Cosine-weighted hemisphere sample around n. pdf = cos(theta) / PI.
vec3 sampleCosineHemisphere(vec3 n, inout uint seed) {
    float u1 = rnd(seed), u2 = rnd(seed);
    float r   = sqrt(u1);
    float phi = TWO_PI * u2;
    vec3 t, b; basis(n, t, b);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

// Solid-angle pdf of sampling the spherical light from p (0 inside / touching it).
float lightSolidAnglePdf(vec3 p) {
    vec3  toL = ubo.light.xyz - p;
    float d2  = dot(toL, toL);
    float r   = ubo.light.w;
    if (d2 <= r * r * 1.0201) return 0.0;   // (1.01 r)^2, same threshold as NEE below
    float sinMax = clamp(r / sqrt(d2), 0.0, 0.999);
    float cosMax = sqrt(1.0 - sinMax * sinMax);
    return 1.0 / (TWO_PI * (1.0 - cosMax));
}

// Power heuristic (beta = 2).
float powerHeuristic(float a, float b) {
    float a2 = a * a;
    return a2 / max(a2 + b * b, 1e-8);
}

// Next event estimation at the current payload hit, MIS-weighted against the
// cosine BSDF pdf. P = offset hit point.
vec3 sampleDirectLight(vec3 N, vec3 P, vec3 albedo, inout uint seed) {
    vec3  toLight = ubo.light.xyz - payload.hitPos;
    float dist    = length(toLight);
    float radius  = ubo.light.w;
    if (dist <= radius * 1.01) return vec3(0.0);

    float sinMax = clamp(radius / dist, 0.0, 0.999);
    float cosMax = sqrt(1.0 - sinMax * sinMax);
    float pdfL   = 1.0 / (TWO_PI * (1.0 - cosMax));

    vec3  Ls    = sampleCone(toLight / dist, cosMax, rnd(seed), rnd(seed));
    float cosNL = dot(N, Ls);
    if (cosNL <= 0.0 || traceShadow(P, Ls, dist - radius * 1.001) >= 0.5) return vec3(0.0);

    // Le * f_d * cos / pdf, weighted against the BSDF pdf of the same direction.
    vec3  Le = ubo.lightColor.rgb * ubo.lightColor.w;
    float w  = powerHeuristic(pdfL, cosNL / PI);
    return (albedo / PI) * Le * cosNL / pdfL * w;
}

vec3 renderSample(inout uint seed, int sampleIdx, int spp) {
    vec2 jitter = vec2(rnd(seed), rnd(seed)) - 0.5;
    vec3 origin = cameraOrigin();
    vec3 dir    = cameraDir(vec2(gl_LaunchIDEXT.xy) + 0.5 + jitter);

    int   maxBounces = int(ubo.frame.w);
    float emission   = ubo.lightColor.w;

    vec3 color      = vec3(0.0);
    vec3 throughput = vec3(1.0);

    // MIS bookkeeping: was the previous bounce specular (mirror / glass), and
    // if it was a diffuse BSDF sample, its pdf and origin vertex.
    bool  lastSpecular = true;   // the camera ray counts as specular: the light is seen directly
    float lastBsdfPdf  = 0.0;
    vec3  lastOrigin   = origin;

    // Hero wavelength + stratified first Fresnel decision, as in the Whitted view.
    int   hero      = sampleIdx % 3;
    bool  dispersed = false;
    int   strata    = max(spp / 3, 1);
    float fresU     = (float(sampleIdx / 3) + rnd(seed)) / float(strata);
    bool  fresFresh = true;

    float pathLen = 0.0;
    int bounce;
    for (bounce = 0; bounce <= maxBounces; ++bounce) {
        traceClosest(origin, dir);

        // Miss: the sky is an environment light. NEE never samples it (only the
        // sphere light), so BSDF samples collect it in full.
        if (payload.t < 0.0) { color += throughput * skyColor(dir); break; }

        pathLen += payload.t;
        vec3 N   = normalize(payload.normal);
        int  mat = int(payload.matId + 0.5);

        if (bounce == 0 && payload.selected > 0.5) color += selectionRim(dir, N);

        // ---- Emissive area light hit by the path itself ----
        if (mat == MAT_EMISSIVE) {
            vec3 Le = payload.albedo * emission;
            // After a specular bounce NEE could not have found this light: count it
            // in full. After a diffuse bounce, MIS-weight against that vertex's NEE.
            float w = lastSpecular ? 1.0 : powerHeuristic(lastBsdfPdf, lightSolidAnglePdf(lastOrigin));
            color += throughput * Le * w;
            break;
        }

        if (mat == MAT_GLASS) {
            float u = fresFresh ? fresU : rnd(seed);
            fresFresh = false;
            glassScatter(N, hero, u, origin, dir, throughput, dispersed);
            lastSpecular = true;
        } else {
            // ---- Floor / solid: diffuse + stochastic mirror lobe ----
            vec3  albedo = surfaceAlbedo(mat, N, dir, pathLen);
            vec3  P      = payload.hitPos + N * EPS;
            float refl   = clamp(payload.reflectivity, 0.0, 1.0);

            // Mirror with probability refl, diffuse otherwise; the 1/prob factor
            // cancels the lobe weight, so throughput passes through or takes the albedo.
            if (rnd(seed) < refl) {
                dir          = reflect(dir, N);
                origin       = P;
                lastSpecular = true;
            } else {
                color += throughput * sampleDirectLight(N, P, albedo, seed);

                // Indirect bounce: f_d * cos / pdf = (albedo/PI) * cos / (cos/PI) = albedo.
                vec3 wi = sampleCosineHemisphere(N, seed);
                lastBsdfPdf  = max(dot(N, wi), 0.0) / PI;
                lastOrigin   = payload.hitPos;
                lastSpecular = false;
                throughput  *= albedo;
                dir    = wi;
                origin = P;
            }
        }

        // ---- Russian roulette ----
        if (bounce >= 3) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (rnd(seed) >= p) break;
            throughput /= p;
        }
    }

    // Out of bounces inside a specular chain: end in the sky (see raygen_rt).
    if (bounce > maxBounces) color += throughput * skyColor(dir);

    return min(color, vec3(FIREFLY_CLAMP));
}

// Glass motion signature: total path length along the deterministic delta
// chain (refract, or reflect on TIR, at the mid IOR) up to the first
// non-glass surface. The primary-hit motion test cannot see movement behind
// or inside glass (the glass surface itself is static), which accumulation
// would smear into ghosts. The chain is deterministic, so for a static scene
// the signature is bit-stable and any change means real motion.
float glassMotionSig(vec3 hitPos, vec3 N, float frontFace, vec3 dir) {
    float sig = 0.0;
    vec3  o   = hitPos;
    vec3  d   = dir;
    vec3  n   = N;
    float ff  = frontFace;
    for (int i = 0; i < 6; ++i) {
        float eta = (ff > 0.5) ? (1.0 / IOR_G) : IOR_G;
        vec3  r   = refract(d, n, eta);
        if (dot(r, r) < 1e-6) { d = reflect(d, n); o += n * EPS; }
        else                  { d = normalize(r);  o -= n * EPS; }

        traceClosest(o, d);
        if (payload.t < 0.0) { sig += 1000.0; break; }   // sky: stable terminator
        sig += payload.t;
        if (int(payload.matId + 0.5) != MAT_GLASS) break;
        o  = payload.hitPos;
        n  = normalize(payload.normal);
        ff = payload.frontFace;
    }
    return sig;
}

void main() {
    vec3  color  = renderPixel();
    ivec2 pix    = ivec2(gl_LaunchIDEXT.xy);
    vec3  curPos = primaryHitPos();   // leaves the centre primary hit in `payload`

    // ---- Denoiser inputs from the centre primary hit ----
    // Guide: geometric edges (normal + depth). Albedo: divided out before
    // filtering (demodulation), so the checkerboard and object colours stay
    // sharp while the noisy irradiance is smoothed. Glass, the lamp and the
    // sky use white (no-op). Glass gets negative depth: its guide describes
    // the surface, not the refracted content, so the denoiser treats it
    // separately (see atrous.comp).
    bool  sky     = payload.t < 0.0;
    int   mat     = int(payload.matId + 0.5);
    bool  isGlass = !sky && mat == MAT_GLASS;
    vec3  gN      = sky ? vec3(0.0) : normalize(payload.normal);
    float gZ      = sky ? 0.0 : (isGlass ? -payload.t : payload.t);
    vec3  centerDir = cameraDir(vec2(gl_LaunchIDEXT.xy) + 0.5);
    vec3  alb     = (!sky && (mat == MAT_FLOOR || mat == MAT_SOLID))
                  ? surfaceAlbedo(mat, gN, centerDir, payload.t) : vec3(1.0);
    imageStore(guideImage,  pix, vec4(gN, gZ));
    imageStore(albedoImage, pix, vec4(alb, 1.0));

    // Glass pixels get a second reprojection key (this clobbers the payload,
    // so it runs after the guide write).
    float curSig = isGlass ? glassMotionSig(curPos, gN, payload.frontFace, centerDir) : 0.0;

    // HDR accumulation -> display. With the denoiser on, the compute pass
    // overwrites this with the filtered result (same display transform).
    vec3 accum = accumulate(pix, color, curPos, curSig);
    imageStore(outImage, pix, vec4(applyMarquee(toDisplay(accum), vec2(pix), ubo.marquee), 1.0));
}
