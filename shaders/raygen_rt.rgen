#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

// Left half: classic Whitted-style ray tracing. Direct light with soft
// shadows, perfect mirror reflection and dispersive glass; global
// illumination is replaced by a constant ambient term.

#include "raygen_common.glsl"

const int   SHADOW_SAMPLES = 6;      // per diffuse hit: smooth penumbra within one frame
const float AMBIENT        = 0.32;   // Whitted's stand-in for global illumination

// Direct light from the spherical area light at the current payload hit:
// returns the irradiance factor (already scaled by the light's radiance).
float directLight(vec3 N, inout uint seed) {
    vec3  toLight = ubo.light.xyz - payload.hitPos;
    float dist    = length(toLight);
    // Inside or touching the lamp (an object dragged into it) there is no
    // shadow segment to trace: tmax would fall below tmin. Same as the
    // path tracer's next event estimation.
    if (dist <= ubo.light.w * 1.01) return 0.0;
    vec3  Lc      = toLight / dist;
    float sinMax  = clamp(ubo.light.w / dist, 0.0, 0.999);
    float cosMax  = sqrt(1.0 - sinMax * sinMax);
    float tmax    = dist - ubo.light.w * 1.001;

    float visible = 0.0;
    for (int i = 0; i < SHADOW_SAMPLES; ++i) {
        // Azimuth stratified over the samples: even coverage of the light disc,
        // less penumbra grain while the camera moves.
        float u1 = rnd(seed);
        float u2 = (float(i) + rnd(seed)) / float(SHADOW_SAMPLES);
        vec3  Ls = sampleCone(Lc, cosMax, u1, u2);
        visible += max(dot(N, Ls), 0.0) * (1.0 - traceShadow(payload.hitPos + N * EPS, Ls, tmax));
    }

    // Le * Omega / pi = 2 * Le * (1 - cosMax): converts the shared emission
    // radiance into the Whitted diffuse factor via the light's solid angle, so
    // direct lighting matches the path tracer's next-event estimate at every
    // distance and the halves differ only in what Whitted cannot compute
    // (indirect light, caustics, colour bleeding).
    return (visible / float(SHADOW_SAMPLES)) * 2.0 * ubo.lightColor.w * (1.0 - cosMax);
}

vec3 renderSample(inout uint seed, int sampleIdx, int spp) {
    vec2 jitter = vec2(rnd(seed), rnd(seed)) - 0.5;
    vec3 origin = cameraOrigin();
    vec3 dir    = cameraDir(vec2(gl_LaunchIDEXT.xy) + 0.5 + jitter);

    int   maxBounces = int(ubo.frame.w);
    float emission   = ubo.lightColor.w;

    vec3 color      = vec3(0.0);
    vec3 throughput = vec3(1.0);

    // Hero wavelength fixed per sample (stratified), see glassScatter.
    int  hero      = sampleIdx % 3;
    bool dispersed = false;

    // Stratified Fresnel decision for the FIRST glass hit: sample s covers
    // stratum s/3 of spp/3, so the reflect/refract split is near exact within
    // one frame instead of relying on accumulation.
    int   strata    = max(spp / 3, 1);
    float fresU     = (float(sampleIdx / 3) + rnd(seed)) / float(strata);
    bool  fresFresh = true;

    float pathLen = 0.0;
    int bounce;
    for (bounce = 0; bounce <= maxBounces; ++bounce) {
        traceClosest(origin, dir);
        if (payload.t < 0.0) { color += throughput * skyColor(dir); break; }

        pathLen += payload.t;
        vec3 N   = normalize(payload.normal);
        int  mat = int(payload.matId + 0.5);

        if (bounce == 0 && payload.selected > 0.5) color += selectionRim(dir, N);

        // The lamp itself, at the shared emission level (ACES rolls it off to white).
        if (mat == MAT_EMISSIVE) { color += throughput * payload.albedo * emission; break; }

        if (mat == MAT_GLASS) {
            float u = fresFresh ? fresU : rnd(seed);
            fresFresh = false;
            glassScatter(N, hero, u, origin, dir, throughput, dispersed);
            continue;
        }

        // ---- Floor / solid: direct light + ambient, optional mirror bounce ----
        vec3 albedo = surfaceAlbedo(mat, N, dir, pathLen);
        // Direct light carries the lamp tint; the ambient stand-in stays neutral.
        vec3 local  = albedo * (vec3(AMBIENT) + directLight(N, seed) * ubo.lightColor.rgb);

        float refl = payload.reflectivity;
        color += throughput * local * (1.0 - refl);
        if (refl <= 0.001) break;

        throughput *= refl;
        dir    = reflect(dir, N);
        origin = payload.hitPos + N * EPS;
    }

    // Out of bounces inside a specular chain (thick or stacked glass): dropping
    // the path leaves black dirt; ending in the sky is slightly biased but clean.
    if (bounce > maxBounces) color += throughput * skyColor(dir);

    return color;
}

void main() {
    vec3  color = renderPixel();
    ivec2 pix   = ivec2(gl_LaunchIDEXT.xy);
    vec3  accum = accumulate(pix, color, primaryHitPos(), 0.0);
    imageStore(outImage, pix, vec4(applyMarquee(toDisplay(accum), vec2(pix), ubo.marquee), 1.0));
}
